    "firebase-functions": "^7.2.5",
    "openai": "^6.39.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^9.39.4",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "eslint": "^9.39.4",
    "eslint-plugin-import": "^2.32.0",
    "firebase-functions-test": "^3.5.0",
